#include <iostream>
#include <map>
using namespace std;

int main()
{
    multimap <char, int> m;
    m.insert(pair<char, int>('a', 30));
    m.insert(pair<char, int>('b', 20));
    m.insert(pair<char, int>('c', 40));
    m.insert(pair<char, int>('d', 20));
    m.insert(pair<char, int>('f', 10));
    m.insert(pair<char, int>('e', 80));
    m.insert(pair<char, int>('d', 10));
    m.insert(pair<char, int>('d', 70));
    
    auto it = m.equal_range('d');
    for (auto i = it.first; i != it.second; ++i)
        cout << (*i).first << " " << (*i).second << endl;

}
