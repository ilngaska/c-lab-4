#include <iostream>
#include <map>
using namespace std;

int main()
{
    multimap <char, int> m;
    m.insert(pair<char, int>('b', 30));
    m.insert(pair<char, int>('a', 40));
    m.insert(pair<char, int>('b', 20));
    m.insert(pair<char, int>('a', 10));
    
    for (auto it = m.begin(); it != m.end(); ++it)
        cout << (*it).first << " " << (*it).second << endl;
        
    return 0;
}
