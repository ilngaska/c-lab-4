#include <iostream>
#include <bitset>
#include <string>

using namespace std;

int main()
{
    // Контейнер з 4 нулів за замовчуванням
    bitset<4> b1; 
    cout << "b1: " << b1 << endl; // Виведе: 0000

    // Ініціалізація цілим числом 20
    bitset<4> b2(20); 
    cout << "b2: " << b2 << endl; // Виведе: 0100

    // Ініціалізація рядком
    bitset<4> b3(string("1101")); 
    cout << "b3: " << b3 << endl; // Виведе: 1101

    // Робота з окремими бітами
    bitset<4> b4; 
    cout << "b4: " << b4 << endl; // Виведе: 0000
    
    b4[1] = 1; // Встановлюємо біт з індексом 1 (рахунок справа наліво з 0) в одиницю
    cout << "b4: " << b4 << endl; // Виведе: 0010

    return 0;
}
