#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() 
{
    int a[]={1,4,6,3,2};
    int b[]={1,6,4};
    int c[]={1,6,8};
    vector <int> v(a,a+5);
    vector <int> t(b,b+3);
    vector <int> p(c,c+3);
    
    sort(v.begin(),v.end());
    sort(t.begin(),t.end());
    sort(p.begin(),p.end());
    
    bool k = includes(v.begin(),v.end(),t.begin(),t.end());
    if (k) cout << '+' << endl;
    else cout << '-' << endl;
    
    k = includes(v.begin(),v.end(),p.begin(),p.end());
    if (k) cout << '+' << endl;
    else cout << '-' << endl;
    
    return 0; 
}
