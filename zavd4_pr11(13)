#include <iostream>
#include <bitset>
#include <string>

using namespace std;

int main() 
{
    // Оскільки 128 біт не помістяться у звичайне число
    // ми ініціалізуємо його за допомогою довгого рядка нулів та одиниць.
    string long_bits = "1011010001110101011110000111101010101010101010101010101010101010"; 
    
    // Створюємо 128-бітний контейнер
    bitset<128> b128(long_bits); 

    cout << "Початковий стан: \n" << b128 << endl;
    cout << "Розмір контейнера: " << b128.size() << " бiт" << endl; // Виведе 128
    cout << "Кiлькiсть одиниць: " << b128.count() << endl;

    b128.flip(2); // Інверсія 2-го біта (рахунок справа наліво, починаючи з 0)
    cout << "Пiсля iнверсiї 2-го бiта: \n" << b128 << endl;

    b128.set(127); // Встановлення найстаршого (127-го) біта в 1
    cout << "Пiсля встановлення 127-го бiта: \n" << b128 << endl;

    b128.reset(3); // Занулення 3-го біта
    cout << "Пiсля занулення 3-го бiта: \n" << b128 << endl;

    b128.reset(); // Занулення абсолютно всіх 128 бітів
    cout << "Пiсля повного занулення: \n" << b128 << endl;

    return 0;
}
